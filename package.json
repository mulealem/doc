{
  "name": "pygate-doc",
  "version": "0.1.0",
  "private": true,
  "description": "PyGate developer documentation site (doc.example.com). Built with Fumadocs on Next.js 16. Static export.",
  "scripts": {
    "dev": "next dev --port 3003",
    "mdx": "fumadocs-mdx",
    "build": "fumadocs-mdx && next build",
    "start": "next start --port 3003",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fumadocs-core": "^15.0.0",
    "fumadocs-mdx": "^11.0.0",
    "fumadocs-ui": "^15.0.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shiki": "^3.13.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^2.1.0"
  },
  "overrides": {
    "picomatch": "^4.0.5"
  }
}
